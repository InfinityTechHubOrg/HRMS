# Crewly — copy to .env and adjust as needed
# Vite only exposes vars prefixed with VITE_

# App
VITE_APP_NAME=Crewly
VITE_APP_CURRENCY=AED

# When replacing src/services with a real API
VITE_API_BASE_URL=http://localhost:3000/api

# Public site origin used for employee card QR verification links
# Leave blank to use window.location.origin
# GitHub Pages example: https://infinitytechhuborg.github.io/HRMS
VITE_PUBLIC_URL=
